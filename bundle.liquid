{% include 'emojis.liquid' %}

.header-wrapper {
	width: 100%;
	margin-bottom: 1em;
}

.title {
	color: var(--gold);
	line-height: 140px;
	text-align: center;
	font-size: 6em;
	height: 140px;
	-webkit-text-stroke-width: 1px;
  	font-family: "Syncopate", sans-serif;
/*	filter: drop-shadow(2px 1px var(--lightgold));*/
}

html, body {
	background-image: url('img/leaves3.jpg');
	background-size: 20%;
	width: 100%;
	margin: 0;
	padding: 0;
	border: 0;
  	font-family: "Yanone Kaffeesatz", sans-serif;
  	font-weight: 400;
	color: var(--gold);
}

a:link,
a:visited,
a:hover,
a:active {
	text-decoration: none;
	color: var(--gold);
}

.nav {
	text-align: center;
	background-color: var(--gold);
	opacity: 95%;
/*	border-top: 2px solid var(--green);*/
/*	border-bottom: 2px solid var(--green);*/
	line-height: 100px;
	margin: 0;
	padding: 0;
  	font-family: "Syncopate", sans-serif;
}

.nav ol {
	margin: 0;
	padding: 0;
}

.nav ol li {
	margin: 0;
	padding: 0;
	display: inline-block;
	list-style: none;
	font-size: 2.1em;
	margin-inline: 1em;
	text-align: center;
}

.nav a:link,
.nav a:visited,
.nav a:hover,
.nav a:active {
	text-decoration: none;
	color: var(--green);
}

.nav a:hover {
	color: var(--lightgold);
}

.nav .nav-fruit {
	display: inline-block;
	width: 100px;
	height: 100px;
	border-radius: 50px;
	background-size: 160%;
	background-position: center;
}

.nav .nav-lemon:hover {
	background-image: url('img/lemon_fade.jpg');
}

.nav .nav-lime:hover {
	background-image: url('img/lime_fade.jpg');
}

.nav .nav-grapefruit:hover {
	background-image: url('img/grapefruit_fade.jpg');
}

.nav .nav-orange:hover {
	background-image: url('img/orange_fade.jpg');
}

hr {
	color: var(--lightgold);
	size: 2px;
}

.footer {
	text-align: left;
	font-size: 1em;
	color: var(--gold);
}

.footer-addon {
	font-size: 0.8em;
}

.home-text {
	font-size: 2em;
	background-color: var(--green);
	padding: 2em;
	border-radius: 200px;
	border: 2px solid var(--lightgold);
	text-align: center;
}

.home-text p {
	width: 70%;
	margin-left: auto;
	margin-right: auto;
}

.home-text a {
	text-decoration: underline;
}