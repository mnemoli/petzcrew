.card .header {
	background-color: var(--lightgold);
	color: var(--sienna);
	font-size:1.2vw;
  	font-family: "Yanone Kaffeesatz", sans-serif;
}

.card h2 {
	padding: 0;
	margin: 0;
	line-height: 2em;
}

.stamp-grid {
	display: flex;
	flex-wrap: wrap;
	border: 2px solid var(--gold);
	background-color: var(--green);
	border-radius: 20px;
}

.stamp-card {
	padding: 0.2em;
}

.stamp-card { transform:rotate(2deg); }
.stamp-card:nth-child(2n) { transform:rotate(-2deg); }

.favorites {
	margin-top: 1em;
	margin-bottom: 1em;
	font-size: 1vw;
	filter: drop-shadow(1px 1px 1px black);
}

.fav-color {
	width: 1em;
	height: 1em;
	border-radius: 0.5em;
	display: inline-block;
	vertical-align: text-top;
	margin-inline: 0.15em;
}

