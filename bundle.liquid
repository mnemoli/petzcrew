:root {
	--green:#55876B;
	--darkgreen: #395B48;
/*	--green:#468966;*/
	--lightgold:#FFF0A5;
	--gold:#FFB03B;
	--sienna:#B64926;
}

.wrapper {
	width: 80%;
	margin-left: auto;
	margin-right: auto;
}

.grid {
	display: grid;
	grid-template-columns: 1fr 1fr 1fr 1fr 1fr;
}

.hex-grid {
	display: grid;
	grid-template-columns: 1fr 1fr 1fr 1fr;
}

.biggrid {
	display: grid;
	grid-template-columns: 1fr;
}

.card {
	overflow: hidden;
	text-align: center;
	border:2px solid var(--lightgold);
	border-radius: 50px;
	margin: 0.5em;
	background-color: var(--green);
	color: var(--lightgold);
}

.card .content {
	padding: 1em;
}

.card .img-wrapper {
	position: relative;
	left: 50%;
	transform: translate(-50%, -0%);
}

.card .circle-bg {
	background-color: white;
	height: 200px;
	width: 200px;
	border-radius: 100px;
	position: relative;
	left: 50%;
	transform: translate(-50%, -0%);
}

.card .circle-bg-big {
	height: 300px;
	width: 300px;
	border-radius: 50%;
}

.card .lemon {
	background-image: url('img/lemon_fade.jpg');
	background-position: center center;
	background-size: 150%;
}

.card .orange {
	background-image: url('img/orange_fade.jpg');
	background-position: center center;
	background-size: 150%;
}

.card .grapefruit {
	background-image: url('img/grapefruit_fade.jpg');
	background-position: center center;
	background-size: 150%;
}

.card .lime {
	background-image: url('img/lime_fade.jpg');
	background-position: center center;
	background-size: 150%;
}

.card img {
	image-rendering: crisp;
	filter: drop-shadow(5px 5px 2px rgba(0,0,0,0.4));
	position: absolute;
	top: 50%;
	left: 50%;
	transform: translate(-50%, -50%);
	width: auto;
	height: auto;
}

